# Backend (скопируйте в backend/.env)
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-in-production"

# Главный (платформенный) админ — ваша панель /platform
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

TELEGRAM_BOT_TOKEN=
PORT=3000
FRONTEND_ORIGIN=http://192.168.1.59:5173
# С телефона в той же Wi‑Fi: откройте http://IP-компьютера:5173
# Несколько адресов через запятую, или * для всех
