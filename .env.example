# Backend (скопируйте в backend/.env)
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-in-production"
NODE_ENV=development
# На сервере: NODE_ENV=production и свой JWT_SECRET
# Если API за nginx: TRUST_PROXY=1
# Телефоны в той же Wi‑Fi: ALLOW_LAN_CORS=1

# Главный (платформенный) админ — панель /platform
# Локально seed подставит admin / admin123, если пусто.
# На сервере (NODE_ENV=production) задайте свой логин и пароль ≥ 12 символов.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Токен от @BotFather в Telegram
TELEGRAM_BOT_TOKEN=
PORT=3000
FRONTEND_ORIGIN=http://192.168.1.59:5173
# С телефона в той же Wi‑Fi: откройте http://IP-компьютера:5173
# Несколько адресов через запятую, или * для всех
# ALLOW_LAN_CORS=1